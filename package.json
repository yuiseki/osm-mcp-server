{
  "name": "osm-mcp-server",
  "version": "0.1.0",
  "description": "A MCP server for OpenStreetMap APIs",
  "private": true,
  "type": "module",
  "bin": {
    "osm-mcp-server": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "npx -y tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "image:build": "docker build -t osm-mcp-server .",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "lint": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run --exclude 'test/live/**'",
    "test:live": "npm run build && vitest run test/live"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
